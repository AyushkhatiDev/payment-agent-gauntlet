# ==============================================================================
# Gauntlet Environment Configuration (TEST MODE ONLY)
# ==============================================================================
# NEVER use live production keys or real card/account credentials.
# All operations must run against Razorpay Test Mode (rzp_test_...) or the in-memory Mock MCP server.
# Copy this file to .env:
#   cp .env.example .env

# Razorpay Test Mode Credentials (Optional if using Mock MCP server, required for LiveTestMode)
# Generated from Razorpay Dashboard -> Settings -> API Keys (in Test Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_TEST_SECRET_HERE

# Anthropic Claude API Key (for running agent evaluations)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MCP Server Configuration
# Defaults to in-memory/stdio mock server. Set to remote URL for real test-mode MCP:
#   RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp
RAZORPAY_MCP_TRANSPORT=mock

# Evaluation Settings
GAUNTLET_RUN_REPETITIONS=1
GAUNTLET_OUTPUT_DIR=results
